!vault/raw/.gitkeep
!vault/raw/.processed/.gitkeep
!vault/wiki/.gitkeep
!vault/outputs/.gitkeep
!vault/system/.gitkeep
!vault/chat-sesiones/.gitkeep

# Node
frontend/node_modules/
frontend/dist/

# IDE / tools
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# OpenSpec (keep specs, ignore nothing special)
# openspec/ is tracked normally
